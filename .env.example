# Copy to .env.local and fill in. Never commit .env.local.

# xAI Grok API — https://console.x.ai
XAI_API_KEY=

# Shopify Dev Dashboard app (client credentials grant)
SHOPIFY_SHOP=your-dev-store        # without .myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# Supabase (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PostHog
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Tavily (optional)
TAVILY_API_KEY=

# Signs AgentPass receipts (any long random string)
AGENTPASS_SECRET=
