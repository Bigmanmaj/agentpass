# Any integration with empty keys runs in MOCK mode, so the app works with this file untouched.
# Copy to .env.local and fill in. Never commit .env.local.

# LLM — any OpenAI-compatible endpoint (see docs/08-team-plan.md "Credits")
# xAI direct: https://api.x.ai/v1 + grok-4.7 | Vercel AI Gateway: https://ai-gateway.vercel.sh/v1 + xai/<model>
LLM_BASE_URL=https://api.x.ai/v1
LLM_API_KEY=
LLM_MODEL=grok-4.7
# Or: Cursor dashboard API key (crsr_...). Runs Grok via @cursor/sdk and takes priority over LLM_API_KEY
CURSOR_API_KEY=

# Shopify Dev Dashboard app (client credentials grant)
SHOPIFY_SHOP=your-dev-store        # without .myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# Supabase (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# PostHog
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# Tavily (optional)
TAVILY_API_KEY=

# Signs AgentPass receipts (any long random string)
AGENTPASS_SECRET=
